<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_simple_task_list" model="ir.ui.view">
        <field name="name">simple.task.list</field>
        <field name="model">simple.task</field>
        <field name="arch" type="xml">
            <list string="Tasks"
                  decoration-danger="is_overdue"
                  decoration-success="state == 'done'">

                <field name="name"/>
                <field name="assigned_to"/>
                <field name="deadline"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"/>
                <field name="is_overdue"/>

            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="view_simple_task_form" model="ir.ui.view">
        <field name="name">simple.task.form</field>
        <field name="model">simple.task</field>
        <field name="arch" type="xml">
            <form string="Task">

                <header>

                    <button name="action_start"
                            type="object"
                            string="Start Task"
                            class="btn-primary"
                            invisible="state != 'todo'"/>

                    <button name="action_done"
                            type="object"
                            string="Mark Done"
                            class="btn-primary"
                            invisible="state != 'progress'"/>

                    <button name="action_reset"
                            type="object"
                            string="Reset"
                            invisible="state == 'todo'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="todo,progress,done"/>

                </header>

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Task Name"/>
                        </h1>
                    </div>

                    <group>

                        <group>
                            <field name="assigned_to"/>
                            <field name="deadline"/>
                            <field name="priority"
                                   widget="priority"/>
                        </group>

                        <group>
                            <field name="is_overdue"
                                   readonly="1"/>
                        </group>

                    </group>

                    <group>
                        <field name="description"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Search View -->
    <record id="view_simple_task_search" model="ir.ui.view">
        <field name="name">simple.task.search</field>
        <field name="model">simple.task</field>
        <field name="arch" type="xml">
            <search string="Search Tasks">

                <field name="name"/>
                <field name="assigned_to"/>

                <filter name="my_tasks"
                        string="My Tasks"
                        domain="[('assigned_to', '=', uid)]"/>

                <filter name="todo"
                        string="To Do"
                        domain="[('state', '=', 'todo')]"/>

                <filter name="progress"
                        string="In Progress"
                        domain="[('state', '=', 'progress')]"/>

                <filter name="done"
                        string="Done"
                        domain="[('state', '=', 'done')]"/>

                <filter name="overdue"
                        string="Overdue"
                        domain="[('is_overdue', '=', True)]"/>

                <group expand="0" string="Group By">

                    <filter name="group_assigned"
                            string="Assigned To"
                            context="{'group_by': 'assigned_to'}"/>

                    <filter name="group_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>

                </group>

            </search>
        </field>
    </record>


    <!-- Kanban View -->
    <record id="view_simple_task_kanban" model="ir.ui.view">
        <field name="name">simple.task.kanban</field>
        <field name="model">simple.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">

                <field name="name"/>
                <field name="assigned_to"/>
                <field name="deadline"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="is_overdue"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">

                            <strong>
                                <field name="name"/>
                            </strong>

                            <div>
                                Assigned:
                                <field name="assigned_to"/>
                            </div>

                            <div>
                                Deadline:
                                <field name="deadline"/>
                            </div>

                            <div>
                                Priority:
                                <field name="priority"
                                       widget="priority"/>
                            </div>

                            <div t-if="record.is_overdue.raw_value">
                                <span class="text-danger">
                                    Overdue
                                </span>
                            </div>

                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>


    <!-- Window Action -->
    <record id="action_simple_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">simple.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id"
               ref="view_simple_task_search"/>
    </record>


    <!-- Menu -->
    <menuitem id="menu_simple_task_root"
              name="Task Management"
              sequence="45"
              groups="base.group_user"/>

    <menuitem id="menu_simple_task"
              name="Tasks"
              parent="menu_simple_task_root"
              action="action_simple_task"
              sequence="10"
              groups="base.group_user"/>

</odoo>